# ── Banco de dados (obrigatórias) ──────────────────────────────────────────────
DB_USER=seu_usuario
DB_PASS=sua_senha
DB_HOST=localhost
DB_NAME=fipe_db

# ── Banco de dados (opcionais) ─────────────────────────────────────────────────
DB_PORT=3306

# ── FIPE (opcionais) ───────────────────────────────────────────────────────────
# Tipo de veículo: 1=carro, 2=moto, 3=caminhão
FIPE_TIPO_VEICULO=1

# Intervalo de tabelas de referência a coletar (deixe em branco para coletar tudo)
FIPE_REF_INICIO=
FIPE_REF_FIM=

# Número de requisições HTTP simultâneas
FIPE_CONCORRENCIA=15

# Linhas acumuladas antes de cada INSERT em lote
FIPE_BATCH_SIZE=200
