# ══════════════════════════════════════════════════════════════════════════════
# FIPE Pipeline — variáveis de ambiente
# ══════════════════════════════════════════════════════════════════════════════

# ── Destino dos dados ──────────────────────────────────────────────────────────
# Pode ser definido aqui OU via CLI: python fipe_coleta.py --sink <valor>
# A flag --sink tem maior prioridade que esta variável.
#
#   s3    (padrão) → Parquet no S3, ideal para AWS Glue Python Shell
#   excel          → .xlsx local, ideal para testar sem infra
#   mysql          → MySQL via SQLAlchemy
FIPE_SINK=s3

# ── S3 (obrigatório se FIPE_SINK=s3) ──────────────────────────────────────────
FIPE_S3_BUCKET=meu-bucket-fipe
# Prefixo dentro do bucket (padrão: fipe/raw/)
FIPE_S3_PREFIX=fipe/raw/
# Credenciais AWS: use variáveis padrão do boto3 OU deixe em branco se
# estiver rodando no Glue (IAM Role assume automaticamente).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# ── Banco de dados (obrigatório apenas se FIPE_SINK=mysql) ─────────────────────
DB_USER=seu_usuario
DB_PASS=sua_senha
DB_HOST=localhost
DB_NAME=fipe_db
DB_PORT=3306

# ── Modo de coleta ─────────────────────────────────────────────────────────────
# false (padrão): coleta APENAS a referência mais recente da API FIPE.
#                 Ideal para rodar automaticamente no dia 1 de cada mês.
# true           : coleta TODO o histórico disponível.
FIPE_HISTORICO=false

# ── Intervalo manual (opcional — sobrescreve FIPE_HISTORICO) ───────────────────
# Informe os códigos numéricos da tabela de referência FIPE.
# Deixe em branco para usar o comportamento automático acima.
FIPE_REF_INICIO=
FIPE_REF_FIM=

# ── Concorrência HTTP por tipo de veículo ──────────────────────────────────────
# Carro roda sozinho na FASE 1 — pode usar mais slots
FIPE_CONCORRENCIA_CARRO=15
# Moto e Caminhão rodam em paralelo na FASE 2 — balanceie conforme sua rede
FIPE_CONCORRENCIA_MOTO=10
FIPE_CONCORRENCIA_CAMINHAO=10

# ── Tamanho do lote de INSERT (só afeta sink=mysql) ───────────────────────────
FIPE_BATCH_SIZE=200
